#!/usr/bin/env bash

set -euo pipefail

fancy_echo() {
  printf "\n%s\n" "$1"
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    printf "Missing required command: %s\n" "$1" >&2
    exit 1
  }
}

fancy_echo "Checking prerequisites..."
require_cmd brew
require_cmd git
require_cmd curl
require_cmd unzip

fancy_echo "Installing apps and CLI tools..."
brew bundle --file=- <<'EOF'
cask "google-chrome"
cask "slack"
cask "iterm2"
cask "firefox"
cask "vlc"
cask "visual-studio-code"
cask "1password"
cask "zoom"
cask "whatsapp"
cask "ghostty"
cask "numi"
cask "logi-options+"
cask "font-fira-code"
cask "codex"

brew "dockutil"
EOF

fancy_echo "Configuring git..."
git config --global user.name "Nik Korablin"
git config --global user.email "nikorablin@gmail.com"
git config --global mergetool.keepBackup false
git config --global push.default current
git config --global pager.branch false

fancy_echo "Installing Oh My Zsh if needed..."
if [[ ! -d "$HOME/.oh-my-zsh" ]]; then
  RUNZSH=no CHSH=no KEEP_ZSHRC=yes \
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
fi

ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"

if [[ ! -d "$ZSH_CUSTOM/themes/spaceship-prompt" ]]; then
  git clone https://github.com/spaceship-prompt/spaceship-prompt.git \
    "$ZSH_CUSTOM/themes/spaceship-prompt" --depth=1
fi

ln -sf \
  "$ZSH_CUSTOM/themes/spaceship-prompt/spaceship.zsh-theme" \
  "$ZSH_CUSTOM/themes/spaceship.zsh-theme"

if [[ ! -d "$ZSH_CUSTOM/plugins/git-open" ]]; then
  git clone https://github.com/paulirish/git-open.git \
    "$ZSH_CUSTOM/plugins/git-open" --depth=1
fi

if [[ ! -d "$ZSH_CUSTOM/plugins/zsh-autosuggestions" ]]; then
  git clone https://github.com/zsh-users/zsh-autosuggestions \
    "$ZSH_CUSTOM/plugins/zsh-autosuggestions" --depth=1
fi

if [[ ! -d "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting" ]]; then
  git clone https://github.com/zsh-users/zsh-syntax-highlighting.git \
    "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting" --depth=1
fi

fancy_echo "Setting up dotfiles..."
TMP_DIR="$(mktemp -d)"
DOTFILES_ZIP="$TMP_DIR/dotfiles.zip"

curl -fsSL \
  https://codeload.github.com/nikorablin/dotfiles/zip/refs/heads/master \
  -o "$DOTFILES_ZIP"

unzip -q "$DOTFILES_ZIP" -d "$TMP_DIR"

rm -rf "$HOME/dotfiles"
mkdir -p "$HOME/dotfiles"
cp -a "$TMP_DIR/dotfiles-master/." "$HOME/dotfiles"

rm -rf "$TMP_DIR"

fancy_echo "Configuring iTerm2 preferences..."
defaults write com.googlecode.iterm2 PrefsCustomFolder -string "$HOME/dotfiles"
defaults write com.googlecode.iterm2 LoadPrefsFromCustomFolder -bool true

fancy_echo "Configuring Dock..."
dockutil --remove all --no-restart || true
dockutil --add "/Applications/Google Chrome.app" --no-restart
dockutil --add "/System/Applications/Messages.app" --no-restart
dockutil --add "/System/Applications/Music.app" --no-restart
dockutil --add "/Applications/iTerm.app" --no-restart
dockutil --add "/Applications/Visual Studio Code.app" --no-restart
dockutil --add "/Applications/WhatsApp.app" --no-restart
killall Dock || true

fancy_echo "Verifying Codex CLI..."
if command -v codex >/dev/null 2>&1; then
  fancy_echo "Codex CLI installed. Run 'codex' to sign in."
else
  fancy_echo "Codex CLI install may need a new terminal session before 'codex' is available."
fi

fancy_echo "Done."