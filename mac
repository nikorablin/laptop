#!/usr/bin/env bash

set -euo pipefail

fancy_echo() {
  printf "\n%s\n" "$1"
}

append_if_missing() {
  local text="$1"
  local file="$2"

  mkdir -p "$(dirname "$file")"
  touch "$file"

  if ! grep -Fqs "$text" "$file"; then
    printf "\n%s\n" "$text" >> "$file"
  fi
}

ZSHRC_LOCAL="$HOME/.zshrc.local"
ZSHRC="$HOME/.zshrc"
SHELL_RC="$ZSHRC"

if [[ -f "$ZSHRC_LOCAL" || ! -w "$ZSHRC" ]]; then
  SHELL_RC="$ZSHRC_LOCAL"
fi

mkdir -p "$HOME/.bin"
touch "$SHELL_RC"

append_if_missing 'export PATH="$HOME/.bin:$PATH"' "$SHELL_RC"

install_homebrew() {
  if ! command -v brew >/dev/null 2>&1; then
    fancy_echo "Installing Homebrew ..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  fi

  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
    append_if_missing 'eval "$(/opt/homebrew/bin/brew shellenv)"' "$SHELL_RC"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
    append_if_missing 'eval "$(/usr/local/bin/brew shellenv)"' "$SHELL_RC"
  else
    fancy_echo "Homebrew installed, but brew not found in expected locations."
    exit 1
  fi
}

ensure_zsh_shell() {
  local zsh_path
  zsh_path="$(command -v zsh)"

  if [[ "${SHELL:-}" != "$zsh_path" ]]; then
    fancy_echo "Changing your login shell to zsh ..."
    chsh -s "$zsh_path"
  fi
}

install_homebrew
ensure_zsh_shell

fancy_echo "Updating Homebrew ..."
brew update

fancy_echo "Installing packages ..."
brew bundle --file=- <<'EOF'
brew "git"
brew "gh"
brew "tmux"
brew "vim"
brew "fnm"
EOF

append_if_missing 'eval "$(fnm env --use-on-cd --shell zsh)"' "$SHELL_RC"

if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --shell bash)"
  fnm install --lts
  fnm default lts-latest
fi

if [[ -f ./laptop.local ]]; then
  fancy_echo "Running laptop.local ..."
  bash ./laptop.local
fi

fancy_echo "Done. Restart your terminal or run:"
fancy_echo "  source \"$SHELL_RC\""